# Non-secret settings shared by the services (ConfigMap petclinic-config).
# Secrets (DB password, JWT_SECRET, admin password) live in the Secret petclinic-secrets,
# see k8s/overlays/local/secrets.env.example.

# In-cluster DNS names: <service>.<namespace>.svc.cluster.local, or just <service> from
# inside the same namespace. These replace the docker compose service names.
DB_HOST=postgres
DB_PORT=5432
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PET_EVENTS=pet-events
# KRaft cluster id (22 chars base64url). Changing it on an existing volume stops Kafka.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg

AUTH_SERVICE_URL=http://auth-service:8081
PET_SERVICE_URL=http://pet-service:8082
ANALYTICS_SERVICE_URL=http://analytics-service:8084
BILLING_GRPC_ADDRESS=static://billing-service:9090

JWT_EXPIRATION_MS=86400000

# server.shutdown=graceful waits at most this long for in-flight requests. Must fit in
# terminationGracePeriodSeconds (40s) together with the 5s preStop sleep.
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=20s

# The JVM sizes its heap from the container memory limit, not the node's RAM. 60% leaves
# room for metaspace, thread stacks and direct buffers inside the 512Mi limit; exiting on
# OOM lets Kubernetes restart the pod instead of keeping a half-broken JVM alive.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
