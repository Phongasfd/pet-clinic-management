# Copy to secrets.env (git-ignored). k8s/scripts/kind-up.sh does it for you and fills in
# random values. Same meaning as in the repo's .env.example.
DB_USERNAME=petclinic_user
DB_PASSWORD=change-me
# base64 of at least 32 bytes: openssl rand -base64 32
JWT_SECRET=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
