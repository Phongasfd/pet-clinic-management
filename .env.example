# ==============================================================================
# PET CLINIC MANAGEMENT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép file này thành .env:
#    cp .env.example .env (Linux/macOS) hoặc copy .env.example .env (Windows)
# 2. Thay đổi các mật khẩu, secret key và thông số phù hợp với môi trường Production.
# 3. KHÔNG BAO GIỜ commit file .env chứa thông tin thật lên Git repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Tài khoản superuser/quản trị PostgreSQL
DB_USERNAME=petclinic_admin
DB_PASSWORD=ChangeThisToAStrongRandomPassword123!

# Tên các database dịch vụ
DB_AUTH_NAME=petclinic_auth
DB_PETS_NAME=pet_clinic_pets
DB_BILLING_NAME=pet_clinic_billing
DB_ANALYTICS_NAME=pet_clinic_analytics

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Secret key dùng để ký và xác thực JWT token (base64, tối thiểu 256-bit). BẮT BUỘC.
# Sinh ngẫu nhiên bằng lệnh: openssl rand -base64 32
# Không dùng giá trị mẫu từ tutorial: ai biết secret là tự ký được token ADMIN.
JWT_SECRET=

# Thời gian sống của JWT token tính bằng milliseconds (86400000 ms = 24 giờ)
JWT_EXPIRATION_MS=86400000

# Tài khoản ADMIN đầu tiên, được tạo khi auth-service khởi động (bỏ qua nếu đã tồn tại).
# /register chỉ tạo CUSTOMER; ADMIN này tạo tài khoản VET/RECEPTIONIST qua POST /api/v1/auth/staff.
# Để trống thì không tạo.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. APACHE KAFKA (KRAFT MODE)
# ------------------------------------------------------------------------------
# Cluster ID cố định cho Kafka KRaft (22 ký tự base64url)
# Có thể sinh bằng: kafka-storage random-cluster-id
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg

# Topic lưu trữ sự kiện pet
KAFKA_TOPIC_PET_EVENTS=pet-events

# ------------------------------------------------------------------------------
# 4. API GATEWAY & NETWORKING
# ------------------------------------------------------------------------------
# Port công khai bên ngoài mà API Gateway sẽ lắng nghe
GATEWAY_PORT=8080

# Profile hoạt động của Spring Boot
SPRING_PROFILES_ACTIVE=prod
